# Vercel Configuration for Next.js Frontend
{
  "name": "workrant-frontend",
  "version": 2,
  "builds": [
    {
      "src": "workrant_frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "workrant_frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://workrant-backend.railway.app/api",
    "NEXT_PUBLIC_BACKEND_URL": "https://workrant-backend.railway.app",
    "NEXT_PUBLIC_BACKEND_HOSTNAME": "workrant-backend.railway.app",
    "NEXT_PUBLIC_BACKEND_PORT": "443",
    "NODE_ENV": "production",
    "NEXT_PUBLIC_SECURE_MODE": "true",
    "NEXT_PUBLIC_DEBUG": "false"
  },
  "regions": ["iad1"],
  "framework": "nextjs"
}