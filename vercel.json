{
  "buildCommand": "cd workrant_frontend && npm run build",
  "outputDirectory": "workrant_frontend/.next",
  "installCommand": "cd workrant_frontend && npm install",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.workrant.app/api",
    "NEXT_PUBLIC_BACKEND_URL": "https://api.workrant.app",
    "NEXT_PUBLIC_MEDIA_URL": "https://api.workrant.app/media",
    "NODE_ENV": "production",
    "NEXT_PUBLIC_ENVIRONMENT": "production",
    "NEXT_PUBLIC_SECURE_MODE": "true",
    "NEXT_PUBLIC_DEBUG": "false"
  }
}
