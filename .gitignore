# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Backend - Only ignore specific backend files
workrant_frontend/
workrant_frontend_backup/
workrant_backend/*.db
workrant_backend/*.log
workrant_backend/media/
workrant_backend/staticfiles/
workrant_backend/__pycache__/
workrant_backend/*/__pycache__/
workrant_backend/*/*/__pycache__/

# Python
venv/
*.pyc
__pycache__/
*.py[cod]
*$py.class

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
