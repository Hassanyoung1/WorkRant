# Production Environment Variables for Render
# Copy these to your Render service environment variables

# Django Core
SECRET_KEY=your-super-secret-django-key-64-chars-long-replace-this
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1

# Database (Render will provide DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-64-chars-long-replace-this

# CORS Settings
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Media and Static Files
MEDIA_URL=/media/
STATIC_URL=/static/

# Logging
LOG_LEVEL=INFO
LOG_FILE=workrant.log

# Optional: Email Configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password